{
  "name": "@number-flow/react-native",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "author": {
    "name": "Maxwell Barvian",
    "email": "max@barvian.me",
    "url": "https://barvian.me"
  },
  "description": "A React Native component to transition and format numbers.",
  "license": "MIT",
  "homepage": "https://number-flow.barvian.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/barvian/number-flow",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/barvian/number-flow/issues"
  },
  "keywords": [
    "react-native",
    "accessible",
    "odometer",
    "animation",
    "number-format",
    "number-animation",
    "animated-number"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bunchee --tsconfig tsconfig.build.json",
    "dev": "bunchee --watch",
    "test": "jest"
  },
  "dependencies": {
    "number-flow": "workspace:*",
    "esm-env": "^1.1.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.6.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "bunchee": "^6.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.74.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-native": ">=0.60"
  }
}
